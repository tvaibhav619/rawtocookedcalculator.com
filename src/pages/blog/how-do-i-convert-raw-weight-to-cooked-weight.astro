---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostContent from '../../components/BlogPostContent.astro';

const locale = 'en';
const BASE = 'https://rawtocookedcalculator.com';
const url = `${BASE}/blog/how-do-i-convert-raw-weight-to-cooked-weight`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${url}#article`,
      headline: 'How Do I Convert Raw Weight to Cooked Weight?',
      name: 'How Do I Convert Raw Weight to Cooked Weight?',
      description: 'Learn how to accurately convert raw food weight to cooked weight (and cooked to raw) using USDA cooking yields. Complete formulas, cheat sheet, and macro tracking guide.',
      url: url,
      mainEntityOfPage: url,
      datePublished: '2026-10-09T08:00:00+00:00',
      dateModified: '2026-10-09T12:00:00+00:00',
      inLanguage: 'en-US',
      author: {
        '@type': 'Person',
        name: 'Vaibhav Tiwari',
        url: `${BASE}/about`,
      },
      publisher: {
        '@type': 'Organization',
        name: 'Raw to Cooked Calculator',
        url: BASE,
        logo: {
          '@type': 'ImageObject',
          url: `${BASE}/favicon.svg`,
        },
      },
      articleSection: 'Nutrition & Culinary Science',
      keywords: [
        'how do i convert raw weight to cooked weight',
        'raw to cooked weight conversion',
        'raw to cooked chicken weight formula',
        'raw to cooked rice ratio',
        'usda cooking yields',
        'how to track cooked food macros',
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${BASE}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Blog',
          item: `${BASE}/blog`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'How do I convert raw weight to cooked weight?',
          item: url,
        },
      ],
    },
  ],
};

const hreflangUrls: Record<string, string> = { en: url };
---

<BaseLayout
  title="How Do I Convert Raw Weight to Cooked Weight? | USDA Yield Guide"
  description="Learn how to accurately convert raw food weight to cooked weight (and cooked to raw) using USDA cooking yields. Master formulas, cheat sheet table, and macro tracking tips."
  canonicalUrl={url}
  jsonLd={jsonLd}
  locale={locale}
  hreflangUrls={hreflangUrls}
>
  <BlogPostContent locale={locale} />
</BaseLayout>
