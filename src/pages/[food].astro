---
import BaseLayout from '../layouts/BaseLayout.astro';
import FoodContent from '../components/FoodContent.astro';
import { SLUG_TO_ID, getFoodBySlug } from '../utils/foods';
import { LOCALES, getFoodFaqItems, getFoodPageMeta } from '../i18n';
import { foodPageHasFullContent } from '../i18n/food-content';

const locale = 'en';

export function getStaticPaths() {
  return Object.keys(SLUG_TO_ID).map((slug) => ({ params: { food: slug } }));
}

const { food: slug } = Astro.params;
const food = getFoodBySlug(slug)!;

if (!food) {
  return Astro.redirect('/');
}

const { title, description } = getFoodPageMeta(locale, food);

const BASE = 'https://rawtocookedcalculator.com';

// Only advertise locales whose food pages are indexable. The others render the
// thin templated layout and are `noindex`'d until translated, so listing them as
// hreflang alternates would point crawlers at pages they've been told to drop.
const hreflangUrls: Record<string, string> = Object.fromEntries(
  LOCALES.filter(foodPageHasFullContent).map((l) => [
    l,
    l === 'en' ? `${BASE}/${slug}` : `${BASE}/${l}/${slug}`,
  ])
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name:
        food.id === 'chicken-breast'
          ? 'Raw to Cooked Chicken Weight Calculator'
          : `${food.name} Raw to Cooked Calculator`,
      alternateName:
        food.id === 'chicken-breast'
          ? ['Raw to Cooked Chicken Calculator', 'Chicken Weight Converter', 'Cooked Chicken Weight Calculator']
          : undefined,
      url: `${BASE}/${slug}`,
      description,
      applicationCategory: 'HealthApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${BASE}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: title,
          item: `${BASE}/${slug}`,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      url: `${BASE}/${slug}`,
      dateModified: '2026-10-09',
      author: {
        '@type': 'Person',
        name: 'Vaibhav Tiwari',
        url: `${BASE}/methodology`,
      },
      publisher: {
        '@type': 'Organization',
        name: 'Raw to Cooked Calculator',
        url: BASE,
      },
      mainEntity: getFoodFaqItems(locale, food).map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={`${BASE}/${slug}`}
  jsonLd={jsonLd}
  locale={locale}
  hreflangUrls={hreflangUrls}
>
  <FoodContent locale={locale} food={food} />
</BaseLayout>
