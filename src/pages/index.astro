---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeContent from '../components/HomeContent.astro';
import { t, LOCALES } from '../i18n';
import { getHomeFaq } from '../i18n/faq';

const locale = 'en';

const BASE = 'https://rawtocookedcalculator.com';
const hreflangUrls: Record<string, string> = { en: `${BASE}/` };
for (const lang of LOCALES) {
  if (lang !== 'en') hreflangUrls[lang] = `${BASE}/${lang}/`;
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Raw to Cooked Weight Conversion Calculator',
      alternateName: [
        'Raw to Cooked Calculator',
        'Raw to Cooked Meat Weight Conversion Calculator',
        'Raw to Cooked Chicken Weight Calculator',
        'Food Cooking Yield Calculator',
      ],
      url: BASE,
      description: t(locale, 'page.homeDescription'),
      applicationCategory: 'HealthApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      keywords: 'raw to cooked weight conversion calculator, raw to cooked meat weight conversion calculator, raw to cooked calculator, raw to cooked chicken weight, raw to cooked food converter, meat cooking yields, usda cooking yields',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      creator: { '@type': 'Organization', name: 'Raw to Cooked Calculator', url: BASE },
    },
    {
      '@type': 'WebSite',
      name: 'Raw to Cooked Calculator',
      url: BASE,
    },
    {
      '@type': 'FAQPage',
      mainEntity: getHomeFaq(locale).map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---

<BaseLayout
  title={t(locale, 'page.homeTitle')}
  description={t(locale, 'page.homeDescription')}
  jsonLd={jsonLd}
  locale={locale}
  hreflangUrls={hreflangUrls}
>
  <HomeContent locale={locale} />
</BaseLayout>
