---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogIndexContent from '../../components/BlogIndexContent.astro';
import { ALL_BLOG_POSTS } from '../../data/blogs';

const locale = 'en';
const BASE = 'https://rawtocookedcalculator.com';
// Canonical points to the primary hub /blog
const url = `${BASE}/blog`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Blog',
      '@id': `${url}#blog`,
      name: 'Raw to Cooked Culinary & Nutrition Blog',
      headline: 'Raw to Cooked Weight Conversion & Nutrition Science Blog',
      description: 'Expert guides on raw to cooked food weight conversions, USDA cooking yields, macro tracking, visual portion estimates, and safe food storage.',
      url: url,
      inLanguage: 'en-US',
      publisher: {
        '@type': 'Organization',
        name: 'Raw to Cooked Calculator',
        url: BASE,
        logo: {
          '@type': 'ImageObject',
          url: `${BASE}/favicon.svg`,
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${BASE}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Blogs',
          item: `${BASE}/blogs`,
        },
      ],
    },
  ],
};

const hreflangUrls: Record<string, string> = { en: url };
---

<BaseLayout
  title="Culinary & Nutrition Science Blog | Raw to Cooked Calculator"
  description="Master raw to cooked food weight conversions, USDA cooking yields, macro tracking, visual portion estimates, and safe food storage with our scientific guides."
  canonicalUrl={url}
  jsonLd={jsonLd}
  locale={locale}
  hreflangUrls={hreflangUrls}
>
  <BlogIndexContent locale={locale} baseUrlPrefix="/blogs" />
</BaseLayout>
