---
import { t, getLangPrefix } from '../i18n';
import type { Locale } from '../i18n';
import { getShortFoodName } from '../i18n/food-names';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const prefix = getLangPrefix(locale);

const popularFoods: { id: string; slug: string }[] = [
  { id: 'chicken-breast', slug: 'chicken' },
  { id: 'white-rice', slug: 'rice' },
  { id: 'ground-beef-80-20', slug: 'beef' },
  { id: 'pasta', slug: 'pasta' },
  { id: 'salmon', slug: 'salmon' },
  { id: 'broccoli', slug: 'broccoli' },
];

const companyLinks: { label: string; href: string }[] = [
  { label: 'Blog', href: '/blog' },
  { label: t(locale, 'footer.about'), href: `${prefix}/about` },
  { label: t(locale, 'footer.contact'), href: `${prefix}/contact` },
  // Methodology is an English-only page — link it only on the English site.
  ...(locale === 'en'
    ? [{ label: t(locale, 'footer.methodology'), href: '/methodology' }]
    : []),
  { label: t(locale, 'footer.privacy'), href: `${prefix}/privacy` },
  { label: t(locale, 'footer.terms'), href: `${prefix}/terms` },
];
---

<footer class="mt-auto border-t border-[var(--color-hairline)] bg-[var(--color-canvas)]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-10">
      <!-- Brand -->
      <div class="col-span-2 sm:col-span-1">
        <p class="text-sm font-semibold text-[var(--color-ink)] mb-2">{t(locale, 'footer.brand')}</p>
        <p class="text-xs text-[var(--color-mute)] leading-relaxed">
          {t(locale, 'footer.tagline')}
        </p>
      </div>

      <!-- Foods -->
      <div>
        <p class="text-xs font-mono font-medium text-[var(--color-mute)] uppercase tracking-wider mb-3">
          {t(locale, 'footer.popularFoods')}
        </p>
        <ul class="space-y-1.5">
          {popularFoods.map(({ id, slug }) => (
            <li>
              <a href={`${prefix}/${slug}`} class="text-xs text-[var(--color-body)] hover:text-[var(--color-ink)] transition-colors no-underline">
                {getShortFoodName(locale, id)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Sources -->
      <div>
        <p class="text-xs font-mono font-medium text-[var(--color-mute)] uppercase tracking-wider mb-3">
          {t(locale, 'footer.dataSources')}
        </p>
        <ul class="space-y-1.5 text-xs text-[var(--color-mute)] leading-relaxed">
          <li>{t(locale, 'footer.usdaMeat')}</li>
          <li>{t(locale, 'footer.usdaHandbook')}</li>
          <li>{t(locale, 'footer.usdaFdc')}</li>
          <li class="pt-1 text-[var(--color-faint)]">{t(locale, 'footer.nonUsdaNote')}</li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <p class="text-xs font-mono font-medium text-[var(--color-mute)] uppercase tracking-wider mb-3">
          {t(locale, 'footer.company')}
        </p>
        <ul class="space-y-1.5">
          {companyLinks.map(({ label, href }) => (
            <li>
              <a href={href} class="text-xs text-[var(--color-body)] hover:text-[var(--color-ink)] transition-colors no-underline">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-[var(--color-hairline)] text-xs text-[var(--color-faint)]">
      {t(locale, 'footer.disclaimer')}
    </div>
  </div>
</footer>
