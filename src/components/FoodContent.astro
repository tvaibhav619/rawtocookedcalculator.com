---
import Calculator from './Calculator.astro';
import { getAllFoods, hasPage } from '../utils/foods';
import type { Food } from '../utils/foods';
import { getExplanationKey, isEstimate } from '../utils/foods';
import { t, tf, getLangPrefix, getYieldDescription, getFoodSource, getFoodFaqItems } from '../i18n';
import type { Locale } from '../i18n';
import { getFoodName, getShortFoodName, getCategoryLabel } from '../i18n/food-names';
import { getExplanation, getMethodLabel } from '../i18n/content';
import { getFoodLongContent, foodPageHasFullContent } from '../i18n/food-content';

interface Props {
  locale: Locale;
  food: Food;
}

const { locale, food } = Astro.props;
const prefix = getLangPrefix(locale);

// en/es/fr/de/pt/it pages carry full, food-specific long-form content. Any
// other locale keeps the shorter templated layout until that content is
// translated, so all the blocks it drives are gated on `hasLongform`.
// (Locales without the full content are also noindex'd — see
// `foodPageHasFullContent` and the food page routes.)
const hasLongform = foodPageHasFullContent(locale);
const longContent = hasLongform ? getFoodLongContent(locale, food.id) : undefined;

// Byline shown on the long-form pages, localized. The methodology page is
// English-only (no [lang] route), so non-English bylines link to it unprefixed.
const BYLINE: Record<string, { text: string; method: string; reviewed: string }> = {
  en: { text: 'Compiled and cross-checked against USDA primary sources by Vaibhav Tiwari.', method: 'Methodology', reviewed: 'Last reviewed September 2026' },
  es: { text: 'Recopilado y contrastado con fuentes primarias del USDA por Vaibhav Tiwari.', method: 'Metodología', reviewed: 'Última revisión: septiembre de 2026' },
  fr: { text: 'Compilé et recoupé avec les sources primaires de l’USDA par Vaibhav Tiwari.', method: 'Méthodologie', reviewed: 'Dernière révision : septembre 2026' },
  de: { text: 'Zusammengestellt und mit USDA-Primärquellen abgeglichen von Vaibhav Tiwari.', method: 'Methodik', reviewed: 'Zuletzt geprüft: September 2026' },
  pt: { text: 'Compilado e verificado com fontes primárias do USDA por Vaibhav Tiwari.', method: 'Metodologia', reviewed: 'Última revisão: setembro de 2026' },
  it: { text: 'Compilato e verificato con le fonti primarie dell’USDA da Vaibhav Tiwari.', method: 'Metodologia', reviewed: 'Ultima revisione: settembre 2026' },
};
const byline = BYLINE[locale] ?? BYLINE.en;

const isChicken = food.id === 'chicken-breast';
const foodName = getFoodName(locale, food.id);
const yieldDesc = getYieldDescription(locale, food);
const explanation = getExplanation(locale, getExplanationKey(food));
const sourceText = getFoodSource(locale, food);
const estimate = isEstimate(food);
const faqItems = getFoodFaqItems(locale, food);

// `hasPage` matters: the category also holds calculator-only foods (spaghetti,
// veal, chickpeas…) that [food].astro never routes, so linking them 404s.
const relatedFoods = getAllFoods()
  .filter((f) => f.id !== food.id && f.category === food.category && hasPage(f))
  .slice(0, 5);

const chickenWeightChart = [
  { raw: '4.0 oz (113g)', cooked: '2.9 oz (82g)', protein: '25.5g', cals: '136 kcal', notes: 'Small cutlet' },
  { raw: '6.0 oz (170g)', cooked: '4.3 oz (122g)', protein: '38.3g', cals: '204 kcal', notes: 'Standard portion' },
  { raw: '8.0 oz (227g)', cooked: '5.8 oz (163g)', protein: '51.0g', cals: '272 kcal', notes: 'Single whole breast' },
  { raw: '10.0 oz (283g)', cooked: '7.2 oz (204g)', protein: '63.8g', cals: '340 kcal', notes: 'Large chicken breast' },
  { raw: '16.0 oz / 1 lb (454g)', cooked: '11.5 oz (327g)', protein: '102.2g', cals: '545 kcal', notes: '1 lb grocery tray' },
  { raw: '100g (3.5 oz)', cooked: '72g (2.5 oz)', protein: '22.5g', cals: '120 kcal', notes: 'USDA 100g standard' },
  { raw: '150g (5.3 oz)', cooked: '108g (3.8 oz)', protein: '33.8g', cals: '180 kcal', notes: 'Lunch portion' },
  { raw: '200g (7.1 oz)', cooked: '144g (5.1 oz)', protein: '45.0g', cals: '240 kcal', notes: 'Standard fitness serving' },
  { raw: '250g (8.8 oz)', cooked: '180g (6.3 oz)', protein: '56.3g', cals: '300 kcal', notes: 'High-protein portion' },
  { raw: '300g (10.6 oz)', cooked: '216g (7.6 oz)', protein: '67.5g', cals: '360 kcal', notes: 'Post-workout dinner' },
  { raw: '500g (1.1 lb)', cooked: '360g (12.7 oz)', protein: '112.5g', cals: '600 kcal', notes: 'Half-kilo batch prep' },
  { raw: '1000g / 1 kg (2.2 lb)', cooked: '720g (25.4 oz)', protein: '225.0g', cals: '1200 kcal', notes: 'Weekly 1 kg bulk prep' },
];
---

<!-- Food hero -->
<section class="border-b border-[var(--color-hairline)]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-14">

    <!-- Eyebrow -->
    <p class="text-xs font-mono font-medium text-[var(--color-mute)] uppercase tracking-wider mb-3">
      {getCategoryLabel(locale, food.category)}
      {estimate && ` · ${t(locale, 'food.estimatedYield')}`}
    </p>

    <!-- H1 -->
    <h1 class="text-3xl sm:text-4xl font-semibold text-[var(--color-ink)] tracking-[-1.5px] leading-tight mb-4">
      {locale === 'en' && isChicken ? (
        <>Raw to Cooked Chicken Weight Calculator</>
      ) : (
        <>{foodName}<br class="hidden sm:block" /> {t(locale, 'food.rawToCookedCalc')}</>
      )}
    </h1>

    <!-- Yield stat -->
    <div class="flex items-center gap-3 bg-[var(--color-surface)] border border-[var(--color-hairline)] rounded-[var(--radius-md)] px-4 py-3 mb-5 w-fit max-w-full">
      <span class="text-2xl font-semibold text-[var(--color-ink)] tabular-nums tracking-tight">
        {food.yield_percent}%
      </span>
      <div>
        <p class="text-sm font-medium text-[var(--color-ink)]">{t(locale, 'food.usdaCookingYield')}</p>
        <p class="text-xs text-[var(--color-mute)]">{yieldDesc}</p>
      </div>
    </div>

    <!-- Explanation -->
    {explanation && (
      <p class="text-sm text-[var(--color-body)] leading-relaxed max-w-xl mb-3">
        {explanation}
      </p>
    )}

    <!-- Source -->
    <p class="text-xs font-mono text-[var(--color-faint)]">
      {t(locale, 'food.source')}: {sourceText}
    </p>

    <!-- Byline (long-form pages only) -->
    {hasLongform && (
      <p class="text-xs text-[var(--color-faint)] leading-relaxed mt-2 max-w-xl">
        {byline.text}{' '}
        <a href="/methodology" class="text-[var(--color-link)] hover:underline">{byline.method}</a>
        {` · ${byline.reviewed}`}
      </p>
    )}
  </div>
</section>

<!-- Chicken-specific: method yields table (non-English; English gets the
     unified long-form treatment below) -->
{!hasLongform && isChicken && food.yield_by_method && (
  <section class="border-b border-[var(--color-hairline)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
      <h2 class="text-xl font-semibold text-[var(--color-ink)] tracking-tight mb-5">
        {t(locale, 'food.yieldByMethod')}
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-xl">
        {Object.entries(food.yield_by_method).map(([method, pct]) => (
          <div class="bg-[var(--color-surface)] border border-[var(--color-hairline)] rounded-[var(--radius-md)] px-4 py-4 text-center">
            <p class="text-2xl font-semibold text-[var(--color-ink)] tabular-nums mb-1">{pct}%</p>
            <p class="text-xs text-[var(--color-mute)]">
              {getMethodLabel(locale, method)}
            </p>
          </div>
        ))}
      </div>
      <p class="mt-4 text-xs text-[var(--color-faint)] font-mono">
        {t(locale, 'food.yieldByMethodSource')}
      </p>
    </div>
  </section>
)}

<!-- Chicken-specific: protein quality note (non-English only) -->
{!hasLongform && isChicken && (
  <section class="border-b border-[var(--color-hairline)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
      <div class="max-w-2xl">
        <h2 class="text-xl font-semibold text-[var(--color-ink)] tracking-tight mb-4">
          {t(locale, 'food.chickenHeading')}
        </h2>
        <p class="text-sm text-[var(--color-body)] leading-relaxed mb-3">
          {t(locale, 'food.chickenP1')}
        </p>
        <p class="text-sm text-[var(--color-body)] leading-relaxed" set:html={t(locale, 'food.chickenP2')} />
      </div>
    </div>
  </section>
)}

<!-- English long-form: why the weight changes -->
{hasLongform && longContent && (
  <section class="border-b border-[var(--color-hairline)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
      <div class="max-w-2xl">
        <h2 class="text-xl font-semibold text-[var(--color-ink)] tracking-tight mb-4">
          {longContent.introHeading}
        </h2>
        {longContent.intro.map((para) => (
          <p class="text-sm text-[var(--color-body)] leading-relaxed mb-3 last:mb-0">{para}</p>
        ))}
      </div>
    </div>
  </section>
)}

<!-- English long-form: yield by method + worked examples -->
{hasLongform && longContent && (
  <section class="border-b border-[var(--color-hairline)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
      <h2 class="text-xl font-semibold text-[var(--color-ink)] tracking-tight mb-5">
        {longContent.methodHeading}
      </h2>
      {food.yield_by_method && (
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-xl mb-6">
          {Object.entries(food.yield_by_method).map(([method, pct]) => (
            <div class="bg-[var(--color-surface)] border border-[var(--color-hairline)] rounded-[var(--radius-md)] px-4 py-4 text-center">
              <p class="text-2xl font-semibold text-[var(--color-ink)] tabular-nums mb-1">{pct}%</p>
              <p class="text-xs text-[var(--color-mute)]">{getMethodLabel(locale, method)}</p>
            </div>
          ))}
        </div>
      )}
      <div class="max-w-2xl">
        {longContent.method.map((para) => (
          <p class="text-sm text-[var(--color-body)] leading-relaxed mb-3 last:mb-0">{para}</p>
        ))}
      </div>
      <p class="mt-4 text-xs text-[var(--color-faint)] font-mono">
        {t(locale, 'food.source')}: {sourceText}
      </p>
    </div>
  </section>
)}

<!-- Calculator -->
<section>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <h2 class="text-lg font-semibold text-[var(--color-ink)] tracking-tight mb-6">
      {tf(locale, 'food.calcHeading', { name: foodName })}
    </h2>
    <div class="max-w-lg">
      <Calculator preselectedId={food.id} locale={locale} />
    </div>
  </div>
</section>

<!-- Chicken Weight Conversion Chart (English only) -->
{locale === 'en' && isChicken && (
  <section class="border-t border-[var(--color-hairline)] bg-[var(--color-surface)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-[var(--radius-pill)] bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-xs font-mono text-[var(--color-mute)] uppercase tracking-wider mb-4">
          USDA Yield Reference · 72% Cooking Yield
        </div>
        <h2 class="text-2xl sm:text-3xl font-semibold text-[var(--color-ink)] tracking-tight mb-3">
          Raw to Cooked Chicken Weight Conversion Table
        </h2>
        <p class="text-sm text-[var(--color-body)] leading-relaxed mb-6">
          Use this quick conversion chart to calculate raw to cooked chicken weight for baked or roasted boneless, skinless chicken breast. Cooked chicken retains all original protein while losing ~28% of its mass to water evaporation.
        </p>

        <!-- Quick formulas -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
          <div class="p-4 rounded-[var(--radius-md)] bg-[var(--color-canvas)] border border-[var(--color-hairline)]">
            <p class="text-xs font-mono text-[var(--color-mute)] uppercase mb-1">To Get Cooked Chicken Weight:</p>
            <p class="font-mono text-sm font-semibold text-[var(--color-ink)]">Cooked Weight = Raw Weight × 0.72</p>
            <p class="text-xs text-[var(--color-mute)] mt-1">Example: 200g raw × 0.72 = 144g cooked</p>
          </div>
          <div class="p-4 rounded-[var(--radius-md)] bg-[var(--color-canvas)] border border-[var(--color-hairline)]">
            <p class="text-xs font-mono text-[var(--color-mute)] uppercase mb-1">To Get Raw Chicken Weight Equivalent:</p>
            <p class="font-mono text-sm font-semibold text-[var(--color-ink)]">Raw Weight = Cooked Weight ÷ 0.72</p>
            <p class="text-xs text-[var(--color-mute)] mt-1">Example: 150g cooked ÷ 0.72 = 208g raw</p>
          </div>
        </div>

        <!-- Table -->
        <div class="overflow-x-auto rounded-[var(--radius-md)] border border-[var(--color-hairline)] bg-[var(--color-canvas)]">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-[var(--color-surface)] border-b border-[var(--color-hairline)] text-xs font-mono text-[var(--color-mute)] uppercase">
              <tr>
                <th class="py-3 px-4 font-medium">Raw Chicken Weight</th>
                <th class="py-3 px-4 font-medium">Cooked Chicken Weight</th>
                <th class="py-3 px-4 font-medium">Protein</th>
                <th class="py-3 px-4 font-medium">Calories</th>
                <th class="py-3 px-4 font-medium hidden sm:table-cell">Portion Context</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--color-hairline)]">
              {chickenWeightChart.map((row) => (
                <tr class="hover:bg-[var(--color-surface)] transition-colors">
                  <td class="py-2.5 px-4 font-semibold text-[var(--color-ink)]">{row.raw}</td>
                  <td class="py-2.5 px-4 font-mono text-[var(--color-link)] font-medium">{row.cooked}</td>
                  <td class="py-2.5 px-4 font-mono text-[var(--color-body)]">{row.protein}</td>
                  <td class="py-2.5 px-4 font-mono text-[var(--color-mute)]">{row.cals}</td>
                  <td class="py-2.5 px-4 text-xs text-[var(--color-mute)] hidden sm:table-cell">{row.notes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
)}

<!-- English long-form: how much raw to buy -->
{hasLongform && longContent && (
  <section class="border-t border-[var(--color-hairline)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
      <div class="max-w-2xl">
        <h2 class="text-xl font-semibold text-[var(--color-ink)] tracking-tight mb-4">
          {longContent.buyingHeading}
        </h2>
        {longContent.buying.map((para) => (
          <p class="text-sm text-[var(--color-body)] leading-relaxed mb-3 last:mb-0">{para}</p>
        ))}
      </div>
    </div>
  </section>
)}

<!-- English long-form: common logging mistakes -->
{hasLongform && longContent && (
  <section class="border-t border-[var(--color-hairline)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
      <div class="max-w-2xl">
        <h2 class="text-xl font-semibold text-[var(--color-ink)] tracking-tight mb-4">
          {longContent.mistakesHeading}
        </h2>
        <ul class="space-y-3">
          {longContent.mistakes.map((item) => (
            <li class="text-sm text-[var(--color-body)] leading-relaxed pl-4 border-l-2 border-[var(--color-hairline)]">
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
)}

<!-- FAQ -->
<section class="border-t border-[var(--color-hairline)]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <h2 class="text-xl font-semibold text-[var(--color-ink)] tracking-tight mb-8">
      {t(locale, 'food.faqHeading')}
    </h2>
    <div class="max-w-2xl border-t border-[var(--color-hairline)]">
      {faqItems.map(({ q, a }) => (
        <details class="group border-b border-[var(--color-hairline)]">
          <summary class="flex items-center justify-between gap-4 py-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden select-none">
            <span class="text-sm font-semibold text-[var(--color-ink)]">{q}</span>
            <svg class="w-4 h-4 shrink-0 text-[var(--color-mute)] transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </summary>
          <p class="text-sm text-[var(--color-body)] leading-relaxed pb-5 pr-8">{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- Related foods -->
<section class="border-t border-[var(--color-hairline)]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <p class="text-xs font-mono font-medium text-[var(--color-mute)] uppercase tracking-wider mb-4">
      {t(locale, 'food.relatedLabel')}
    </p>
    <div class="flex flex-wrap gap-2">
      {relatedFoods.map((f) => (
        <a
          href={`${prefix}/${f.slug}`}
          class="text-sm px-3 py-1.5 bg-[var(--color-surface)] border border-[var(--color-hairline)] rounded-[var(--radius-pill-category)] text-[var(--color-body)] no-underline hover:text-[var(--color-ink)] hover:bg-[var(--color-hairline-soft)] transition-colors"
        >
          {getShortFoodName(locale, f.id)}
        </a>
      ))}
      <a
        href={`${prefix}/`}
        class="text-sm px-3 py-1.5 bg-[var(--color-surface)] border border-[var(--color-hairline)] rounded-[var(--radius-pill-category)] text-[var(--color-mute)] no-underline hover:text-[var(--color-ink)] hover:bg-[var(--color-hairline-soft)] transition-colors"
      >
        {t(locale, 'food.allFoods')}
      </a>
    </div>
  </div>
</section>
