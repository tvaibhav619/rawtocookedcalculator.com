---
interface Props {
  locale?: string;
  title: string;
  description: string;
  canonicalUrl?: string;
  jsonLd?: object;
  hreflangUrls?: Record<string, string>;
  ogImage?: string;
  /** Emit `<meta name="robots" content="noindex, follow">` — for pages not yet
   *  fit to be indexed (e.g. localized food pages awaiting translated content). */
  noindex?: boolean;
}

const {
  locale = 'en',
  title,
  description,
  canonicalUrl,
  jsonLd,
  hreflangUrls,
  ogImage = 'https://rawtocookedcalculator.com/og-image.png',
  noindex = false,
} = Astro.props;
const canon = canonicalUrl ?? Astro.url.href;

// BCP-47 → Open Graph locale codes.
const OG_LOCALES: Record<string, string> = {
  en: 'en_US',
  es: 'es_ES',
  fr: 'fr_FR',
  de: 'de_DE',
  pt: 'pt_BR',
  it: 'it_IT',
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canon} />
{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Favicon -->
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="raw2cook" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canon} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="Raw to Cooked Calculator" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={OG_LOCALES[locale] ?? 'en_US'} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={title} />

<!-- Geist fonts — loaded without blocking the first paint. --font-sans/--font-mono
     fall back to Arial / ui-monospace until the webfont arrives (font-display: swap). -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="preload"
  as="style"
  href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
/>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
  media="print"
  onload="this.media='all'"
/>
<noscript>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
  />
</noscript>

<!-- hreflang alternate links for multilingual SEO -->
{hreflangUrls && Object.entries(hreflangUrls).map(([lang, href]) => (
  <link rel="alternate" hreflang={lang} href={href} />
))}
{hreflangUrls && <link rel="alternate" hreflang="x-default" href={hreflangUrls['en'] ?? canon} />}

<!-- Dark mode: resolve before first paint to avoid flash -->
<script is:inline>
  (function () {
    var saved = localStorage.getItem('theme');
    var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    document.documentElement.dataset.theme = saved ?? (prefersDark ? 'dark' : 'light');
  })();
</script>

<!-- Google Analytics — gtag.js (~90 KiB) is kept off the critical path: it loads on
     the first user interaction, or after 3.5s, whichever comes first. -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-ZYV3QLFX70');
  (function () {
    var loaded = false;
    var events = ['pointerdown', 'keydown', 'scroll', 'touchstart'];
    function loadGA() {
      if (loaded) return;
      loaded = true;
      events.forEach(function (e) { window.removeEventListener(e, loadGA, { passive: true }); });
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-ZYV3QLFX70';
      document.head.appendChild(s);
    }
    events.forEach(function (e) { window.addEventListener(e, loadGA, { passive: true }); });
    setTimeout(loadGA, 3500);
  })();
</script>

<!-- Google AdSense -->
<script
  async
  src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9553031422918283"
  crossorigin="anonymous"
></script>

<!-- JSON-LD structured data -->
{jsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}
